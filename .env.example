// ---------------------------------------------------------------------------
// Content studio. Copy to .env.local for local use, and add the same values in
// Vercel under Settings -> Environment Variables for the deployed site.
//
// The studio stays switched off (its route 404s) until ADMIN_KEY and
// ADMIN_PASSWORD are both set and long enough. That is deliberate: the endpoint
// can rewrite the whole site, so it does not run half-configured.
// ---------------------------------------------------------------------------

// Secret path segment. The studio lives at /admin/<ADMIN_KEY>.
// Minimum 16 characters. Generate one with:  openssl rand -hex 16
ADMIN_KEY=

// Studio password. Minimum 12 characters. Use something long and unique —
// serverless functions share no memory, so there is no real rate limiting
// behind this; the password's length is the actual protection.
ADMIN_PASSWORD=

// Optional. Signs the session cookie. Leave unset and it is derived from the
// password, which means changing the password signs you out everywhere.
ADMIN_SESSION_SECRET=

// ---------------------------------------------------------------------------
// Publishing. Saves are committed to src/data/content.json in this repository,
// which makes Vercel rebuild. Without these the studio still edits and offers
// "Download JSON", but the Publish button is disabled.
// ---------------------------------------------------------------------------

// A fine-grained personal access token, scoped to THIS repository only, with
// Repository permissions -> Contents: Read and write. Nothing else.
// github.com/settings/personal-access-tokens
GITHUB_TOKEN=

// owner/repository
GITHUB_REPO=Unni-Krishnan-M/portfolio

// Branch to commit to. Whatever Vercel deploys from.
GITHUB_BRANCH=main
